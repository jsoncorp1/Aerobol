# Solo para el stack local de compose.yaml. No subir el .env real.
POSTGRES_PASSWORD=CAMBIAR_POR_UNA_CLAVE_LARGA_SIN_PUNTO_Y_COMA
AEROBOL_ALLOWED_HOSTS=localhost;127.0.0.1
# Solo prueba LOCAL por HTTP. Coolify debe usar Production y HTTPS.
AEROBOL_ENVIRONMENT=Development
AEROBOL_BEHIND_PROXY=false
AEROBOL_TRUSTED_PROXY_CIDRS=
