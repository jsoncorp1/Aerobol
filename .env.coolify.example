# Plantilla para Environment Variables de Coolify; reemplazar valores.
ConnectionStrings__Aerobol=Host=HOST_POSTGRES17;Port=5432;Database=aerobol;Username=USUARIO;Password=SECRETO;SSL Mode=VerifyFull;Channel Binding=Require
AllowedHosts=academia.ejemplo.com;localhost;127.0.0.1
